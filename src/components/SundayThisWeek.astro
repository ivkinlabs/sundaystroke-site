---
import { SUNDAY_NO_EVENTS } from '../lib/sundayIssue';
import { displayRange } from '../utils/dates';
import type { SundayEvent } from '../types/sunday';

interface Props {
  events: readonly SundayEvent[];
}

const { events } = Astro.props;
---
<section aria-labelledby="this-week" class="ss-card not-prose my-10 p-5 md:p-6" data-sunday-this-week>
  <h2 id="this-week" class="ss-eyebrow">This week</h2>
  {events.length === 0 ? (
    <p class="mt-3 text-ice">{SUNDAY_NO_EVENTS}</p>
  ) : (
    <ul class="mt-4 flex flex-col divide-y divide-line">
      {events.map((event) => (
        <li class="flex flex-col gap-1 py-3 first:pt-0 last:pb-0">
          <span class="ss-tag text-mist"><time datetime={event.starts}>{displayRange(event.starts, event.ends)}</time> · {event.venue}</span>
          <a href={event.sourceUrl} class="font-semibold text-ice hover:text-volt">{event.name}</a>
          <span class="text-sm leading-relaxed text-mist">{event.whyWatch}</span>
        </li>
      ))}
    </ul>
  )}
</section>
