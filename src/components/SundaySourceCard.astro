---
import type { SundayItem } from '../types/sunday';

interface Props {
  item: SundayItem;
}

const { item } = Astro.props;
---
<a
  href={item.sourceUrl}
  class="not-prose mt-5 flex flex-col gap-1.5 rounded-xl border border-line bg-raised p-4 text-ice no-underline transition-colors hover:border-volt focus-visible:border-volt"
  data-source-card="text"
>
  <span class="ss-tag text-mist">{item.sourceLabel}</span>
  <span class="font-semibold leading-snug">Read the full story at {item.sourceLabel}</span>
  <span class="text-sm text-volt">Read the original story <span aria-hidden="true">→</span></span>
</a>
