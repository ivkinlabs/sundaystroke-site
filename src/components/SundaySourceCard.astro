---
import type { SundayItem } from '../types/sunday';

interface Props {
  item: SundayItem;
}

const { item } = Astro.props;
---
<a
  href={item.sourceUrl}
  class="not-prose mt-5 flex items-center justify-between gap-3 rounded-xl border border-line bg-raised p-4 font-semibold leading-snug text-ice no-underline transition-colors hover:border-volt focus-visible:border-volt"
>
  <span>Read the full story at {item.sourceLabel}</span>
  <span class="text-volt" aria-hidden="true">→</span>
</a>
