---
import type { SundayItem } from '../types/sunday';

interface Props {
  item: SundayItem;
}

const { item } = Astro.props;
const siteName = item.preview?.siteName ?? item.sourceLabel;
const image = item.preview?.image ?? null;
---
<a
  href={item.sourceUrl}
  class="not-prose mt-5 flex items-center overflow-hidden rounded-xl border border-line bg-raised text-ice no-underline transition-colors hover:border-volt focus-visible:border-volt"
>
  {image !== null && (
    <img
      src={image}
      alt=""
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      class="aspect-[1.91/1] w-32 shrink-0 object-cover sm:w-40"
    />
  )}
  <span class="flex min-w-0 flex-col gap-1 px-4 py-3">
    <span class="ss-tag text-mist">{siteName}</span>
    <span class="text-sm font-semibold text-volt">Read at {siteName} <span aria-hidden="true">→</span></span>
  </span>
</a>
