---
import ArticlePage from '../../../components/ArticlePage.astro';
import SundayLeadStory from '../../../components/SundayLeadStory.astro';
import SundayQuickHits from '../../../components/SundayQuickHits.astro';
import SundayRoundTip from '../../../components/SundayRoundTip.astro';
import SundayStoryCard from '../../../components/SundayStoryCard.astro';
import SundayThisWeek from '../../../components/SundayThisWeek.astro';
import { SUNDAY_ISSUES } from '../../../data/sunday';
import { SUNDAY_SECTION_HEADINGS } from '../../../lib/sundayIssue';
import { sitePath } from '../../../utils/paths';
import type { SundayIssue, SundaySection, SundaySectionKey } from '../../../types/sunday';
import type { GetStaticPaths } from 'astro';

interface Props {
  issue: SundayIssue;
}

export const getStaticPaths = (() =>
  SUNDAY_ISSUES.map((issue) => ({ params: { slug: issue.slug }, props: { issue } }))) satisfies GetStaticPaths;

const { issue } = Astro.props;
const anchor = (key: SundaySectionKey): string => SUNDAY_SECTION_HEADINGS[key].toLowerCase().replaceAll(' ', '-');
const storyAnchor = (section: SundaySection, at: number): string => `${anchor(section.key)}-${at + 1}`;

---
<ArticlePage
  pageTitle={issue.pageTitle}
  description={issue.summary}
  eyebrow={`The Sunday post · Issue ${issue.number}`}
  heading={issue.title}
  dates={{ published: issue.date, modified: issue.date }}
  banner={null}
  calls={[]}
>
  {issue.lead !== null && <SundayLeadStory item={issue.lead} />}

  {issue.editorNote !== null && (
    <section aria-labelledby="editors-note">
      <h2 id="editors-note" class="!mt-0">Editor’s note</h2>
      <p class="text-lg leading-relaxed !text-ice">{issue.editorNote}</p>
    </section>
  )}

  {issue.quickHits.length > 0 && <SundayQuickHits hits={issue.quickHits} />}

  {issue.thisWeek !== null && <SundayThisWeek events={issue.thisWeek} />}

  {issue.sections.map((section) => (
    <section data-section={section.key} aria-labelledby={anchor(section.key)}>
      <h2 id={anchor(section.key)} class="scroll-mt-28 border-t border-line pt-10">{SUNDAY_SECTION_HEADINGS[section.key]}</h2>
      {section.items.map((item, at) => (
        <SundayStoryCard item={item} anchor={storyAnchor(section, at)} />
      ))}
    </section>
  ))}

  {issue.sundayRound !== null && <SundayRoundTip tip={issue.sundayRound} />}

  <p><a href={sitePath('/sunday/')}>All issues</a></p>
</ArticlePage>
