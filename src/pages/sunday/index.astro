---
import ArticlePage from '../../components/ArticlePage.astro';
import { SUNDAY_ISSUES } from '../../data/sunday';
import { sitePath } from '../../utils/paths';

---
<ArticlePage
  pageTitle="The Sunday post · SundayStroke"
  description="The week in golf and disc golf for club golfers: results, rules and tour news, with a link to every original story. Browse every issue of The Sunday post."
  eyebrow="The Sunday post"
  heading="The Sunday post"
  dates={null}
  banner={null}
  calls={[]}
>
  <p>The Sunday post is the week in golf and disc golf for club golfers: results, rules and tour news, with a link to every original story. Browse the issues below.</p>
  <h2>Issues</h2>
  <ul>
    {SUNDAY_ISSUES.map((issue) => (
      <li><a href={sitePath(`/sunday/${issue.slug}/`)}>Issue {issue.number}, {issue.date}</a>: {issue.summary}</li>
    ))}
  </ul>
</ArticlePage>
