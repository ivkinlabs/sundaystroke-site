---
import ArticlePage from '../../components/ArticlePage.astro';
import { SUNDAY_ISSUES } from '../../data/sunday';
import { sitePath } from '../../utils/paths';

---
<ArticlePage
  pageTitle="The Sunday post · SundayStroke"
  description="A short weekly read on the week in golf and disc golf: what happened, why it matters to a club golfer, and links to the full stories."
  eyebrow="The Sunday post"
  heading="The Sunday post"
  dates={null}
  banner={null}
  calls={[]}
>
  <p>Every Sunday, a few minutes on the week in golf and disc golf: what happened, in our own words, why it matters to a club golfer, and a link to each full story.</p>
  <h2>Issues</h2>
  <ul>
    {[...SUNDAY_ISSUES].reverse().map((issue) => (
      <li><a href={sitePath(`/sunday/${issue.slug}/`)}>Issue {issue.number}, {issue.date}</a>: {issue.summary}</li>
    ))}
  </ul>
</ArticlePage>
